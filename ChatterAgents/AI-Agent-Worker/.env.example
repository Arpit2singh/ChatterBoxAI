# =========================================================================
# ChatterBox AI - Agent Worker Environment Variables
# Copy this file to .env and insert your API keys and credentials.
# =========================================================================

# Groq / OpenAI API Key (used for Whisper STT, LLaMA / GPT LLM inference, Orpheus TTS)
OPENAI_API_KEY=gsk_your_groq_or_openai_api_key_here

# LiveKit WebRTC Cloud Credentials
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud

# Optional: Vector Store / ChromaDB Configuration
chroma_api_key=your_chroma_api_key
chroma_tenant=your_chroma_tenant_id
chroma_database=your_chroma_database

# Optional: NVIDIA Cloud API Key
NVIDIA_API_KEY=your_nvidia_api_key
